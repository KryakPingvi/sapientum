{
  "all": true,
  "src": ["apps/api/dist/src", "packages/contracts/dist"],
  "include": [
    "apps/api/src/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "apps/api/dist/src/**/*.js",
    "packages/contracts/dist/**/*.js"
  ],
  "exclude": ["**/*.d.ts", "apps/api/src/modules/staff/application/ports.ts"],
  "exclude-after-remap": true,
  "reporter": ["text", "html", "lcov", "cobertura", "json-summary"],
  "reports-dir": "coverage"
}
