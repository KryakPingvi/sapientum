# Add application environment variables here as services are implemented.
# Keep real credentials in .env, which is excluded from Git.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sapientum_test
# Auth host configuration; no default signing key. Use at least 32 random bytes encoded as base64.
JWT_SIGNING_KEY_BASE64=
JWT_ISSUER=sapientum
JWT_AUDIENCE=sapientum-api
